# Copy this file to `.env` for local overrides.
# Local development and deployed environments should use different values.

# Host port mappings
API_HOST_PORT=8080
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=9092
ZOOKEEPER_PORT=2181
SCHEMA_REGISTRY_PORT=8081
KAFDROP_PORT=9000

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arbiter
DATABASE_URL=postgres://postgres:postgres@postgres:5432/arbiter?sslmode=disable

# API
API_ADDRESS=:8080

# Topics
RAW_TICKS_COINBASE_TOPIC=raw.ticks.coinbase
RAW_TICKS_KRAKEN_TOPIC=raw.ticks.kraken
NORMALIZED_TICKS_TOPIC=normalized.ticks
SIGNALS_TOPIC=arbitrage.signals

# Exchange subscriptions
COINBASE_PRODUCT_ID=BTC-USD
KRAKEN_SYMBOL=BTC/USD

# Long-running service consumer groups
NORMALIZER_COINBASE_GROUP_ID=arbiter-normalizer
NORMALIZER_KRAKEN_GROUP_ID=arbiter-normalizer-kraken
DETECTOR_GROUP_ID=arbiter-detector
SIGNAL_WRITER_GROUP_ID=arbiter-signal-writer

# Start offsets
NORMALIZER_START_OFFSET=latest
DETECTOR_START_OFFSET=latest
SIGNAL_WRITER_START_OFFSET=latest

# Detector tuning
MAX_QUOTE_AGE_MS=5000
MAX_QUOTE_GAP_MS=500
MIN_SIGNAL_INTERVAL_MS=500
MIN_SIGNAL_PROFIT=0
FEE_BPS=0
